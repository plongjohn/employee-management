{% extends 'layout/base.html.twig' %}

{% set isEdit = employeeId is not null %}
{% set listParameters = listQuery.toParameters() %}
{% set title = isEdit ? t('FormTitleEdit') : t('FormTitleAdd') %}

{% macro label(for, text) %}
    <label class="form-label" for="{{ for }}">
        {{ text }}<span class="app-required" aria-hidden="true">*</span>
    </label>
{% endmacro %}

{% macro field_error(fieldErrors, field) %}
    {% if fieldErrors[field] is defined %}
        <div class="invalid-feedback" id="{{ field }}-error">{{ fieldErrors[field] }}</div>
    {% endif %}
{% endmacro %}

{% macro error_attributes(fieldErrors, field) %}
    {%- if fieldErrors[field] is defined %}aria-invalid="true" aria-describedby="{{ field }}-error"{% endif -%}
{% endmacro %}

{% block title %}{{ title }} – {{ t('AppTitle') }}{% endblock %}

{% block content %}
    <div class="app-card app-card-narrow">
        <h1 class="app-heading">{{ title }}</h1>

        {% if isConflict %}
            <div class="alert alert-warning" role="alert" data-conflict-alert>
                <h2 class="alert-heading fs-6 fw-semibold">{{ t('ConflictHeading') }}</h2>
                <p>{{ t('ConflictText') }}</p>
                <div class="d-flex gap-2">
                    <a class="btn btn-sm btn-dark"
                       href="/employees/{{ employeeId }}/edit{{ listParameters ? '?' ~ listParameters|url_encode }}">
                        {{ t('ConflictReload') }}
                    </a>
                    <button type="button" class="btn btn-sm btn-outline-dark" data-bs-dismiss="alert">
                        {{ t('ConflictBack') }}
                    </button>
                </div>
            </div>
        {% endif %}

        <form id="employee-form" method="post" novalidate
              action="{{ isEdit ? '/employees/' ~ employeeId : '/employees' }}">
            {{ csrf_field() }}
            <input type="hidden" name="original" value="{{ originalJson }}" data-original>
            {% if isEdit %}
                <input type="hidden" name="version" value="{{ version }}">
            {% endif %}
            {% for name, value in listParameters %}
                <input type="hidden" name="{{ name }}" value="{{ value }}">
            {% endfor %}

            <div class="row g-3">
                <div class="col-md-6">
                    {{ _self.label('firstName', t('LabelFirstName')) }}
                    <input class="form-control{{ fieldErrors.firstName is defined ? ' is-invalid' }}" type="text"
                           {{ _self.error_attributes(fieldErrors, 'firstName') }}
                           id="firstName" name="firstName" value="{{ values.firstName }}"
                           maxlength="{{ nameMaxLength }}" autocomplete="off" required data-required>
                    {{ _self.field_error(fieldErrors, 'firstName') }}
                </div>
                <div class="col-md-6">
                    {{ _self.label('lastName', t('LabelLastName')) }}
                    <input class="form-control{{ fieldErrors.lastName is defined ? ' is-invalid' }}" type="text"
                           {{ _self.error_attributes(fieldErrors, 'lastName') }}
                           id="lastName" name="lastName" value="{{ values.lastName }}"
                           maxlength="{{ nameMaxLength }}" autocomplete="off" required data-required>
                    {{ _self.field_error(fieldErrors, 'lastName') }}
                </div>
                <div class="col-12">
                    {{ _self.label('email', t('LabelEmail')) }}
                    <input class="form-control{{ fieldErrors.email is defined ? ' is-invalid' }}" type="text"
                           {{ _self.error_attributes(fieldErrors, 'email') }}
                           inputmode="email" id="email" name="email" value="{{ values.email }}"
                           maxlength="{{ emailMaxLength }}" autocomplete="off" required data-required>
                    {{ _self.field_error(fieldErrors, 'email') }}
                </div>
                <div class="col-md-6">
                    {{ _self.label('departmentId', t('LabelDepartment')) }}
                    <select class="form-select{{ fieldErrors.departmentId is defined ? ' is-invalid' }}"
                            {{ _self.error_attributes(fieldErrors, 'departmentId') }}
                            id="departmentId" name="departmentId" required data-required>
                        <option value="">{{ t('DepartmentPlaceholder') }}</option>
                        {% for department in departments %}
                            <option value="{{ department.id }}"{{ department.id ~ '' == values.departmentId ? ' selected' }}>
                                {{ department.name }}
                            </option>
                        {% endfor %}
                    </select>
                    {{ _self.field_error(fieldErrors, 'departmentId') }}
                </div>
                <div class="col-md-6">
                    {{ _self.label('hireDate', t('LabelHireDate')) }}
                    <input class="form-control{{ fieldErrors.hireDate is defined ? ' is-invalid' }}" type="date"
                           {{ _self.error_attributes(fieldErrors, 'hireDate') }}
                           id="hireDate" name="hireDate" value="{{ values.hireDate }}"
                           min="{{ earliestHireDate }}" max="{{ latestHireDate }}" required data-required>
                    {{ _self.field_error(fieldErrors, 'hireDate') }}
                </div>
            </div>

            <p class="app-required-note">
                <span class="app-required" aria-hidden="true">*</span> {{ t('RequiredField') }}
            </p>

            <div class="d-flex justify-content-end gap-2">
                <a class="btn btn-outline-dark" data-cancel
                   href="/employees{{ listParameters ? '?' ~ listParameters|url_encode }}">
                    {{ t('Cancel') }}
                </a>
                {# A disabled button shows no tooltip, so the wrapper carries it. #}
                <span class="d-inline-block" tabindex="0" data-save-hint
                      data-hint-no-changes="{{ t('SaveNoChangesHint') }}"
                      data-hint-required="{{ t('SaveRequiredFieldsHint') }}">
                    <button type="submit" class="btn btn-primary" data-save>{{ t('Save') }}</button>
                </span>
            </div>
        </form>
    </div>

    <div class="modal fade" id="discard-dialog" tabindex="-1" aria-labelledby="discard-dialog-title" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="discard-dialog-title">{{ t('DiscardHeading') }}</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ t('Close') }}"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">{{ t('DiscardText') }}</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-dark" data-bs-dismiss="modal">{{ t('DiscardKeepEditing') }}</button>
                    <button type="button" class="btn btn-primary" data-discard-confirm>{{ t('DiscardConfirm') }}</button>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block scripts %}
    <script src="/assets/js/employee-form.js"></script>
{% endblock %}
