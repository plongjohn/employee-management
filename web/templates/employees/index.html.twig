{% extends 'layout/base.html.twig' %}

{% block content %}
    {% set listParameters = query.toParameters() %}

    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <h1 class="app-heading mb-0">{{ t('ListHeading') }}</h1>
        <a class="btn btn-primary" href="/employees/new{{ listParameters ? '?' ~ listParameters|url_encode }}"
           data-add-employee-link>
            <i class="bi bi-plus-lg" aria-hidden="true"></i>
            {{ t('AddEmployee') }}
        </a>
    </div>

    <div class="app-card p-0">
        <form id="employee-filter" class="app-toolbar" method="get" action="/employees" role="search">
            <div class="app-search">
                <label class="visually-hidden" for="search">{{ t('SearchLabel') }}</label>
                <input class="form-control" type="search" id="search" name="q" value="{{ query.searchText }}"
                       placeholder="{{ t('SearchPlaceholder') }}" autocomplete="off">
                <button class="btn app-search-button" type="submit" title="{{ t('SearchButton') }}">
                    <i class="bi bi-search" aria-hidden="true"></i>
                    <span class="spinner-border spinner-border-sm app-search-spinner" aria-hidden="true"></span>
                    <span class="visually-hidden">{{ t('SearchButton') }}</span>
                </button>
            </div>

            <label class="visually-hidden" for="department">{{ t('FilterDepartmentLabel') }}</label>
            <select class="form-select app-department-filter" id="department" name="department" data-auto-submit>
                <option value="">{{ t('FilterAllDepartments') }}</option>
                {% for department in departments %}
                    <option value="{{ department.id }}"{{ department.id == query.departmentId ? ' selected' }}>
                        {{ department.name }}
                    </option>
                {% endfor %}
            </select>

            {# Sorting and page size stay when searching; the page starts again at 1. #}
            {% if listParameters.sort is defined %}<input type="hidden" name="sort" value="{{ listParameters.sort }}">{% endif %}
            {% if listParameters.dir is defined %}<input type="hidden" name="dir" value="{{ listParameters.dir }}">{% endif %}
        </form>

        {% include 'employees/_list.html.twig' %}
    </div>

    {# Outside the list, so it survives when the list is replaced; screen readers announce new results. #}
    <div class="visually-hidden" aria-live="polite" data-result-announcement></div>
{% endblock %}

{% block scripts %}
    <script src="/assets/js/employee-list.js"></script>
{% endblock %}
