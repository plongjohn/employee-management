<Project>
  <!--
    Warnings are not treated as errors here on purpose: a newly published NuGet
    vulnerability advisory would otherwise break the build on a reviewer's machine.
    CI builds with -warnaserror instead.
  -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
</Project>
